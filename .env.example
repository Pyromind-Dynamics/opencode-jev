REFLEX_ENABLED=true

# Complete OpenRouter Decisions URL, not a chat-completions base URL.
JEV_URL=https://openrouter.ai/api/alpha/decisions
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_MS=3000

# All three coding models share this OpenAI-compatible endpoint and key.
REFLEX_LLM_BASE_URL=https://openrouter.ai/api/v1
REFLEX_LLM_API_KEY=
REFLEX_MODEL_SMALL=
REFLEX_MODEL_NORMAL=
REFLEX_MODEL_STRONG=

REFLEX_ROUTE_CONFIDENCE=0.80
REFLEX_PERMISSION_CONFIDENCE=0.90
REFLEX_OUTCOME_CONFIDENCE=0.80
REFLEX_MAX_CORRECTIONS=2
REFLEX_MAX_PROVIDER_TURNS=30
